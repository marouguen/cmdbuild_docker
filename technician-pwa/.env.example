VITE_API_BASE=/cmdbuild/services/rest/v3/
OPENMAINT_ORIGIN=http://localhost:8091

# Optional deployment branding. Leave unset to use the reusable product's generic defaults.
# VITE_APP_NAME=Maintenance Hub
# VITE_APP_SHORT_NAME=Maintenance
# VITE_DEPLOYMENT_NAME=Lamastore

# Optional openMAINT group-to-workspace mapping. MaintOffice is the provisional
# Manager group for the current pilot and must be confirmed with a live manager account.
# VITE_TECHNICIAN_ROLE=Team
# VITE_REQUESTER_ROLE=Requester
# VITE_MANAGER_ROLE=MaintOffice
